{
  "name": "dsh-pwa-plugin",
  "version": "1.1.2",
  "description": "PWA plugin for DeepSeek Harness - adds offline support and install capability",
  "type": "module",
  "main": "src/host/index.js",
  "exports": {
    ".": "./src/host/index.js",
    "./sw": "./src/sw.js",
    "./manifest": "./public/manifest.webmanifest"
  },
  "files": [
    "src/",
    "public/",
    "cordis.patch.yml",
    "CHANGELOG.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "pwa",
    "service-worker",
    "offline",
    "offline-first",
    "web-manifest",
    "progressive-web-app"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RaulLazaro/dsh-pwa-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/RaulLazaro/dsh-pwa-plugin/issues"
  },
  "homepage": "https://github.com/RaulLazaro/dsh-pwa-plugin#readme",
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/*.mjs"
  }
}
